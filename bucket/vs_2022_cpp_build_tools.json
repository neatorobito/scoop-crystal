{
    "version": "17.0",
    "description": "Visual Studio 2022 C++ Build Tools",
    "url": "https://aka.ms/vs/17/release/vs_BuildTools.exe",
    "hash": "2A6AA7D94E38D457A4EB3930FC60056ECAB06865B2EB925E5275B8473A017583",
    "installer": {
        "file": "vs_BuildTools.exe",
        "args": [
            "--passive",
            "--norestart",
            "--wait",
            "--add",
            "Microsoft.VisualStudio.Workload.VCTools",
            "--add",
            "Microsoft.VisualStudio.Component.VC.ATL",
            "--includeRecommended"
        ],
        "keep": true
    },
    "uninstaller": {
        "file": "vs_BuildTools.exe",
        "args": [
            "--passive",
            "--norestart",
            "--wait",
            "--remove",
            "Microsoft.VisualStudio.Workload.VCTools",
            "--remove",
            "Microsoft.VisualStudio.Component.VC.ATL",
            "--includeRecommended"
        ]
    }
}
